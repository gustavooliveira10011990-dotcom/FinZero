# Supabase Public Keys (Usadas pelo frontend no navegador)
# Obtenha no painel do Supabase: Project Settings -> API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# O segredo ADMIN_PASSWORD e a SUPABASE_SERVICE_ROLE_KEY NUNCA devem estar aqui nem no frontend.
# Eles devem ser configurados como segredo no Supabase Edge Functions:
# Exemplo via CLI:
# supabase secrets set ADMIN_PASSWORD="sua-senha-segura-aqui"
